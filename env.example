# Salin file ini jadi ".env" (tanpa ".example") lalu isi nilainya.
# Jangan pernah upload file ".env" yang sudah terisi ke GitHub / tempat publik.

# WAJIB — kunci rahasia buat JWT. Isi dengan teks acak yang panjang,
# contoh cara generate cepat lewat terminal:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=@wsp301002

# WAJIB — connection string MongoDB.
# Untuk development lokal (MongoDB jalan di komputer sendiri):
#   MONGO_URI=mongodb://localhost:27017/portofolioverse
# Untuk MongoDB Atlas (cloud, buat production):
#   MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portofolioverse
MONGO_URI=mongodb+srv://wahyusuryap30_db_user:0UXVshbCJErgpfxC@cluster0.y5vkoec.mongodb.net/?appName=Cluster0

# Opsional — port server. Default 5000 kalau dikosongkan.
PORT=5000

# WAJIB sebelum ada orang lain pakai — buat kirim kode verifikasi & reset password.
#
# OPSI A (disarankan buat aplikasi yang dipakai banyak orang) — Brevo:
#   Gratis 300 email/hari, nggak perlu kartu kredit, dan didesain buat kirim
#   email otomatis kayak ini (beda dari Gmail yang bisa nge-block pengiriman
#   otomatis dari server, apalagi dari lokasi/negara yang beda dari biasanya).
#   1. Daftar gratis di https://www.brevo.com
#   2. Di dashboard, buka Settings > SMTP & API > SMTP, catat "SMTP Server",
#      "Port", "Login", dan generate "SMTP Key" (ini yang dipakai sebagai password)
#   3. Isi begini:
#        EMAIL_HOST=smtp-relay.brevo.com
#        EMAIL_PORT=587
#        EMAIL_USER=<login SMTP dari Brevo>
#        EMAIL_PASS=<SMTP Key dari Brevo>
#        EMAIL_FROM=<email pengirim yang sudah kamu verifikasi di Brevo>
#
# OPSI B (paling cepat buat coba-coba sendiri dulu, TAPI kurang cocok kalau
# sudah dipakai banyak orang — Google bisa mem-block pengiriman otomatis) — Gmail:
#   1. Aktifkan verifikasi 2 langkah di akun Google kamu
#   2. Buat "App Password" di https://myaccount.google.com/apppasswords
#   3. Isi EMAIL_USER dengan email Gmail kamu, EMAIL_PASS dengan App Password itu
#      (BUKAN password Gmail biasa), dan JANGAN isi EMAIL_HOST/EMAIL_PORT
#
# Kalau semua ini dikosongkan, kode verifikasi/reset cuma tampil di log server
# (cukup buat development sendiri, TIDAK cukup buat aplikasi yang dipakai orang lain).
EMAIL_HOST=
EMAIL_PORT=
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# WAJIB diisi begitu frontend sudah di-deploy terpisah dari backend
# (misalnya backend di Render, frontend di Vercel/Netlify).
# Boleh lebih dari satu domain, pisahkan dengan koma.
# Kalau frontend disajikan dari server yang sama (public/index.html), boleh
# dikosongkan — defaultnya sudah mengizinkan localhost buat development.
FRONTEND_URL=
